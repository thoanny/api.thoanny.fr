{% extends 'base.html.twig' %}

{% block title %}Hello UserController!{% endblock %}

{% block body %}

    <div class="max-w-xs mx-auto">
        <h1 class="text-3xl font-bold text-primary mb-4">Mon compte</h1>

        <ul class="list bg-base-100 rounded-box shadow">
            <li class="list-row">
                <div>
                    <div class="font-semibold">Pseudonyme</div>
                    <div class="text-base-content/75">{{ app.user.nickname }}</div>
                </div>
            </li>
            <li class="list-row">
                <div>
                    <div class="font-semibold">Adresse e-mail</div>
                    <div class="text-base-content/75">{{ app.user.email }}</div>
                </div>
            </li>
            <li class="list-row">
                <div>
                    <div class="font-semibold">Création du compte</div>
                    <div class="text-base-content/75">{{ app.user.createdAt|format_datetime('long', 'short') }}</div>
                </div>
            </li>
            <li class="list-row">
                <div>
                    <div class="font-semibold">Dernière connexion</div>
                    <div class="text-base-content/75">{{ app.user.lastLoginAt|format_datetime('long', 'short') }}</div>
                </div>
            </li>
        </ul>

        <h2 class="my-4 text-secondary text-2xl font-bold">Comptes liés</h2>

        <ul class="list bg-base-100 rounded-box shadow">
            <li class="list-row">
                <div>
                    <svg  xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-brand-patreon rounded-full shrink-0 bg-primary p-2 text-primary-content size-10"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7.462 3.1c2.615 -1.268 6.226 -1.446 9.063 -.503c2.568 .853 4.471 3.175 4.475 5.81c.004 3.061 -1.942 5.492 -4.896 6.243c-1.693 .43 -2.338 .75 -2.942 1.582c-.238 .328 -.45 .745 -.796 1.533l-.22 .5c-1.146 2.601 -2.156 3.762 -4.236 3.735c-2.232 -.03 -3.603 -1.742 -4.313 -4.48c-.458 -1.768 -.617 -3.808 -.594 -5.876c.044 -3.993 1.42 -7.072 4.46 -8.545z" /></svg>
                </div>
                <div>
                    <h3 class="font-semibold">Lier votre compte Patreon</h3>
                    <div class="text-base-content/75">Profitez de vos avantages d'abonnement Patreon.</div>
                    {% if app.user.patreonUid %}
                        <a href="{{ path('app_user_patreon_unlink') }}" class="btn btn-sm btn-outline btn-error mt-2">Délier mon compte Patreon</a>
                    {% else %}
                        <a class="btn btn-sm btn-primary btn-outline mt-2" href="{{ patreon_link_url }}">Lier mon compte Patreon</a>
                    {% endif %}
                </div>
            </li>
            <li class="list-row">
                <div>
                    <svg  xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-brand-twitch rounded-full shrink-0 bg-primary p-2 text-primary-content size-10"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 5v11a1 1 0 0 0 1 1h2v4l4 -4h5.584c.266 0 .52 -.105 .707 -.293l2.415 -2.414c.187 -.188 .293 -.442 .293 -.708v-8.585a1 1 0 0 0 -1 -1h-14a1 1 0 0 0 -1 1z" /><path d="M16 8l0 4" /><path d="M12 8l0 4" /></svg>
                </div>
                <div>
                    <h3 class="font-semibold">Lier votre compte Twitch</h3>
                    <div class="text-base-content/75">Profitez de vos avantages d'abonnement Twitch.</div>
                    {% if app.user.twitchUid %}
                        <a href="{{ path('app_user_twitch_unlink') }}" class="btn btn-sm btn-outline btn-error mt-2">Délier mon compte Twitch</a>
                    {% else %}
                        <a class="btn btn-sm btn-primary btn-outline mt-2" href="{{ twitch_link_url }}">Lier mon compte Twitch</a>
                    {% endif %}
                </div>
            </li>
        </ul>
    </div>

{% endblock %}
