{% extends 'base.html.twig' %}

{% block title %}Connexion | {{ parent() }}{% endblock %}

{% block body %}
    <form method="post">
        {% if error %}
            <div class="alert alert-error mb-4">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {% if app.user %}
            <div class="">
                Vous êtes connecté en tant que {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">se déconnecter</a>
            </div>
        {% else %}
            <fieldset class="fieldset bg-base-200 border-base-300 rounded-box w-xs border p-4 mx-auto">
                <legend class="fieldset-legend">Connexion</legend>

                <label for="username" class="label required">Adresse e-mail</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" class="input" autocomplete="email" required autofocus>

                <label for="password" class="label required">Mot de passe</label>
                <input type="password" name="_password" id="password" class="input" autocomplete="current-password" required>

                <input type="hidden" name="_csrf_token"
                       value="{{ csrf_token('authenticate') }}"
                >

                {#
                Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
                See https://symfony.com/doc/current/security/remember_me.html

                <div class="checkbox mb-3">
                    <input type="checkbox" name="_remember_me" id="_remember_me">
                    <label for="_remember_me">Remember me</label>
                </div>
                #}

                <button class="btn btn-primary mt-2" type="submit">
                    Se connecter
                </button>

                <div class="mt-2 flex justify-center">
                    <a href="{{ path('app_forgot_password_request') }}" class="link">Mot de passe oublié&nbsp;?</a>
                </div>
            </fieldset>
        {% endif %}

    </form>
{% endblock %}
