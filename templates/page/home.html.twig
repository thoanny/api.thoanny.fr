{% extends 'base.html.twig' %}

{% block body %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        {% for site in sites.list %}
            <a href="{{ site.url }}" target="_blank" class="flex flex-col gap-1 p-4 rounded-box shadow hover:shadow-lg group">
                <h4 class="text-primary font-bold">{{ site.name }}</h4>
                <div class="grow">
                    <p class="md:line-clamp-2">{{ site.description }}</p>
                </div>
                <p><small class="text-base-content/50 group-hover:underline">{{ site.domain }}</small></p>
            </a>
        {% endfor %}
    </div>
{% endblock %}
