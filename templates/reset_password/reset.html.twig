{% extends 'base.html.twig' %}

{% block title %}Modifier mon mot de passe | {{ parent() }}{% endblock %}

{% block body %}

    {% for flash_error in app.flashes('reset_password_error') %}
        <div class="alert alert-error mb-4" role="alert">{{ flash_error }}</div>
    {% endfor %}

    {{ form_start(resetForm) }}

    <fieldset class="fieldset bg-base-200 border-base-300 rounded-box w-xs border p-4 mx-auto">
        <legend class="fieldset-legend">Modification du mot de passe</legend>

        {{ form_label(resetForm.plainPassword.first) }}
        {{ form_widget(resetForm.plainPassword.first) }}

        {{ form_label(resetForm.plainPassword.second) }}
        {{ form_widget(resetForm.plainPassword.second) }}

        <button class="btn btn-primary mt-2">Enregistrer mon mot de passe</button>
    </fieldset>


    {{ form_end(resetForm) }}
{% endblock %}
