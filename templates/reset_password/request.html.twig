{% extends 'base.html.twig' %}

{% block title %}Réinitialiser mon mot de passe | {{ parent() }}{% endblock %}

{% block body %}

    {% for flash_error in app.flashes('reset_password_error') %}
        <div class="alert alert-error mb-4" role="alert">{{ flash_error }}</div>
    {% endfor %}

    {{ form_start(requestForm) }}

        <fieldset class="fieldset bg-base-200 border-base-300 rounded-box w-xs border p-4 mx-auto">
            <legend class="fieldset-legend">Réinitialisation du mot de passe</legend>
            <p>
                Saisissez l'adresse e-mail de votre compte, et nous vous enverons un lien pour réinitiliser votre mot de passe.
            </p>

            {{ form_label(requestForm.email) }}
            {{ form_widget(requestForm.email) }}

            <button class="btn btn-primary mt-2">Recevoir l'e-mail</button>

        </fieldset>

    {{ form_end(requestForm) }}
{% endblock %}
